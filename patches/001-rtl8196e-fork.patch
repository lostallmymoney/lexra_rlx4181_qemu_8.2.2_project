diff -ruN a/qemu-8.2.2/hw/misc/rtl8196e_soc.c b/qemu-8.2.2/hw/misc/rtl8196e_soc.c
--- a/qemu-8.2.2/hw/misc/rtl8196e_soc.c	1969-12-31 19:00:00.000000000 -0500
+++ b/qemu-8.2.2/hw/misc/rtl8196e_soc.c	2026-11-11 16:18:56.932618437 -0500
@@ -0,0 +1,1314 @@
+/*
+ * RTL8196E SoC block for the Sengled Z02-HUB emulation bench.
+ *
+ * Register contracts: vendor kernel source (arch/mips rtl8196c
+ * platform.h; arch/rlx BSP symbol names) and the decompiled bootcode.
+ * See emulation-design.md in the bench repository root.
+ */
+#include "qemu/osdep.h"
+#include "exec/address-spaces.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/misc/rtl8196e_soc.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "sysemu/runstate.h"
+#include "sysemu/sysemu.h"
+
+/* register offsets within the aperture */
+#define REG_REVR        0x0000
+#define REG_RESETCAUSE  0x0008
+#define REG_STRAP       0x000c
+#define REG_SFCR        0x1200
+#define REG_SFCR2       0x1204
+#define REG_SFCSR       0x1208
+#define REG_SFDR        0x120c
+#define REG_SFDR2       0x1210
+#define REG_GIMR        0x3000
+#define REG_GISR        0x3004
+#define REG_IRR0        0x3008
+#define REG_TC0DATA     0x3100
+#define REG_TC1DATA     0x3104
+#define REG_TC0CNT      0x3108
+#define REG_TC1CNT      0x310c
+#define REG_TCCNR       0x3110
+#define REG_TCIR        0x3114
+#define REG_CDBR        0x3118
+#define REG_WDTCNR      0x311c
+
+#define CHIP_ID_8196E   0x8196e000
+#define RESET_CAUSE_WDT (1u << 23)
+
+/* TCCNR bits */
+#define TC0EN   (1u << 31)
+#define TC0MODE (1u << 30)
+#define TC1EN   (1u << 29)
+#define TC1MODE (1u << 28)
+/* TCIR bits */
+#define TC0IE   (1u << 31)
+#define TC1IE   (1u << 30)
+#define TC0IP   (1u << 29)
+#define TC1IP   (1u << 28)
+
+#define WDT_KICK_BIT    (1u << 23)
+/* Watchdog period: a calibration, not a discovered constant (design
+ * section 3.6). The healthy kernel kicks it on every 10 ms timer tick;
+ * 2 s of virtual time leaves two orders of magnitude of margin while
+ * still catching a dead kernel quickly. */
+#define WDT_PERIOD_NS   (2LL * 1000 * 1000 * 1000)
+
+/* survives the device reset that the watchdog itself requests */
+static uint32_t pending_reset_cause;
+
+static void rtl_soc_update_irq(RTL8196ESoc *s)
+{
+    /*
+     * The IRR nibble selects the CPU-visible line directly
+     * (bspchip.h: BSP_*_RS values are BSP IRQ numbers): 0..7 are
+     * the CP0 interrupt pins (ip_out 0..7); 8..15 are the Lexra
+     * LOPI lines (ip_out 8..15), delivered through the CPU's
+     * EStatus/ECause/IntVec registers.
+     */
+    bool ip[16] = { false };
+    uint32_t active = s->src_level & s->gimr;
+    int src;
+
+    for (src = 0; src < 32; src++) {
+        if (active & (1u << src)) {
+            uint32_t rs = (s->irr[src / 8] >> ((src % 8) * 4)) & 0xf;
+            ip[rs] = true;
+        }
+    }
+    for (int i = 0; i < 16; i++) {
+        if (ip[i] != ((s->ip_sent >> i) & 1)) {
+            s->ip_sent = deposit32(s->ip_sent, i, 1, ip[i] ? 1 : 0);
+            qemu_set_irq(s->ip_out[i], ip[i]);
+        }
+    }
+}
+
+static void rtl_soc_set_src(void *opaque, int n, int level)
+{
+    RTL8196ESoc *s = opaque;
+
+    s->src_level = deposit32(s->src_level, n, 1, level ? 1 : 0);
+    rtl_soc_update_irq(s);
+}
+
+/* ---- CPU packet interface (Phase 3) ----
+ *
+ * The switch core's CPU DMA engine, contract from the vendor
+ * driver (drivers/net/rtl819x/rtl865xc_swNic.c, common/mbuf.h,
+ * AsicDriver/rtl865xc_asicregs.h); design section 3.10.
+ *
+ * Rings live in guest RAM: arrays of 32-bit words, each word a
+ * descriptor pointer with bit0 = Own (1 = switch-owned) and
+ * bit1 = Wrap. Guest pointers are kseg0/kseg1 addresses; the
+ * physical address is the low 29 bits. All guest structures are
+ * big-endian.
+ *
+ * Rx: a frame from the backend is written into the cluster of
+ * the pkthdr at the ASIC cursor of ring 0 (all CPUQDM queues map
+ * to ring 0 on this hub), the pkthdr is stamped the way the
+ * Rome ASIC stamps it (ph_len includes the 4 FCS bytes the
+ * driver subtracts, both checksum-ok bits set -- the driver's
+ * receive path drops any frame without them, source portlist =
+ * the board's single external port 0, ph_vlanId = that port's
+ * group vid 9), the entry's Own bit is cleared and RX_DONE
+ * pends. The paired Rx mbuf ring entry (same order) is consumed
+ * with it. With no switch-owned entry the frame drops and the
+ * RUNOUT bits pend, as on silicon.
+ *
+ * Tx: when the driver sets CPUICR.TXFD, every switch-owned Tx
+ * entry is gathered from its mbuf chain (m_len bytes at m_data,
+ * chain ends at MBUF_EOR), emitted to the backend, returned to
+ * the driver (Own cleared) with TX_DONE (and TX_ALL_DONE once
+ * the ring drains) pending; TXFD self-clears.
+ *
+ * Documented limits (what this cannot catch): no FCS/CRC is
+ * computed or checked in either direction (frames with bad
+ * checksums are accepted and marked checksum-ok); no ASIC
+ * table lookup is performed -- every CPU-originated frame is
+ * emitted to the segment and every segment frame is delivered
+ * to the CPU port, which on a two-node segment is the board's
+ * real topology but cannot exercise flooding/learning
+ * decisions among the unpopulated ports; no rate limiting,
+ * QoS queues or 802.1Q tag insertion/removal beyond the
+ * ingress PVID stamp above; descriptor timing is synchronous
+ * (TX completes inside the TXFD write), so guest races that
+ * depend on DMA latency do not reproduce.
+ */
+
+#define CPUICR_TXCMD   (1u << 31)
+#define CPUICR_RXCMD   (1u << 30)
+#define CPUICR_TXFD    (1u << 23)
+#define CPUICR_SOFTRST (1u << 22)
+
+#define CPUIISR_LINK_CHANGE   (1u << 31)
+#define CPUIISR_MBUF_RUNOUT   (1u << 11)
+#define CPUIISR_PKT_RUNOUT(r) (1u << (17 + (r)))
+#define CPUIISR_TX_DONE(r)    (1u << (9 + (r)))
+#define CPUIISR_TX_ALL_DONE(r) (1u << (1 + (r)))
+#define CPUIISR_RX_DONE(r)    (1u << (3 + (r)))
+
+/* struct rtl_pktHdr / rtl_mBuf field offsets (common/mbuf.h) */
+#define PH_MBUF    0x00
+#define PH_LEN     0x04
+/* struct rtl_pktHdr field offsets (common/mbuf.h): ph_flags is the
+ * u16 at +0x0C (after ph_reason at +0x0A), ph_portlist the u8 at
+ * +0x0F (after ph_orgtos), ph_vlanId the low 12 bits of the u16 at
+ * +0x10. Stamping +0x0E/+0x11/+0x12 (an earlier draft's guess) put
+ * the checksum bits into ph_orgtos/ph_portlist and the vid into
+ * _flags2, so the driver dropped every frame at its csum gate. */
+#define PH_FLAGS   0x0c
+#define PH_PORTLIST 0x0f
+#define PH_VLAN    0x10
+#define MB_NEXT    0x00
+#define MB_LEN     0x08
+#define MB_FLAGS   0x0a
+#define MB_DATA    0x0c
+#define MB_EXTBUF  0x10
+#define MB_EXTSIZE 0x14
+#define MBUF_EOR   0x04
+
+/* On receive the ASIC stamps ph_portlist with the source port INDEX:
+ * rtl_decideRxDevice() selects the net_device by (cp->portmask &
+ * (1 << pid)), so pid is a bit number, not a mask (the TX direction
+ * does use a mask). The bench's one populated external port is 0. */
+#define HUB_EXT_PORTLIST 0x00
+#define HUB_EXT_PORT_VID 9    /* its VLAN group (driver boot log) */
+
+static uint32_t guest_pa(uint32_t va)
+{
+    return va & 0x1fffffff;
+}
+
+static uint32_t dma_rd32(RTL8196ESoc *s, uint32_t pa)
+{
+    uint8_t b[4];
+
+    address_space_read(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED,
+                       b, 4);
+    return ((uint32_t)b[0] << 24) | ((uint32_t)b[1] << 16) |
+           ((uint32_t)b[2] << 8) | b[3];
+}
+
+static void dma_wr32(RTL8196ESoc *s, uint32_t pa, uint32_t v)
+{
+    uint8_t b[4] = { v >> 24, v >> 16, v >> 8, v };
+
+    address_space_write(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED,
+                        b, 4);
+}
+
+static uint16_t dma_rd16(RTL8196ESoc *s, uint32_t pa)
+{
+    uint8_t b[2];
+
+    address_space_read(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED,
+                       b, 2);
+    return ((uint32_t)b[0] << 8) | b[1];
+}
+
+static void dma_wr16(RTL8196ESoc *s, uint32_t pa, uint16_t v)
+{
+    uint8_t b[2] = { v >> 8, v };
+
+    address_space_write(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED,
+                        b, 2);
+}
+
+static void dma_wr8(RTL8196ESoc *s, uint32_t pa, uint8_t v)
+{
+    address_space_write(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED,
+                        &v, 1);
+}
+
+static void cpuif_update_irq(RTL8196ESoc *s)
+{
+    int lvl = (s->cpuiisr & s->cpuiimr) != 0;
+
+    if (lvl != ((s->src_level >> RTL_IRQ_SWCORE) & 1)) {
+        s->src_level = deposit32(s->src_level, RTL_IRQ_SWCORE, 1, lvl);
+        rtl_soc_update_irq(s);
+    }
+}
+
+static void cpuif_deliver(RTL8196ESoc *s, const uint8_t *buf, size_t len)
+{
+    uint32_t ring = 0, base, entry, pkthdr, mbuf, extbuf;
+    uint16_t extsize, flags, vlan;
+
+    if (!(s->cpuicr & CPUICR_RXCMD)) {
+        s->nic_rx_runout++;
+        return;
+    }
+    base = s->rpdcr[ring];
+    if (base == 0) {
+        s->nic_rx_runout++;
+        return;
+    }
+    entry = dma_rd32(s, guest_pa(base) + 4 * s->rx_cur[ring]);
+    if (!(entry & 1)) {
+        /* no switch-owned descriptor: silicon drops + RUNOUT */
+        s->cpuiisr |= CPUIISR_PKT_RUNOUT(ring) | CPUIISR_MBUF_RUNOUT;
+        s->nic_rx_runout++;
+        cpuif_update_irq(s);
+        return;
+    }
+    pkthdr = guest_pa(entry & ~3u);
+    mbuf = guest_pa(dma_rd32(s, pkthdr + PH_MBUF));
+    extbuf = guest_pa(dma_rd32(s, mbuf + MB_EXTBUF));
+    extsize = dma_rd16(s, mbuf + MB_EXTSIZE);
+    if (len > extsize) {
+        s->nic_rx_runout++;
+        return;
+    }
+    address_space_write(&address_space_memory, extbuf,
+                        MEMTXATTRS_UNSPECIFIED, buf, len);
+    dma_wr16(s, mbuf + MB_LEN, len);
+    dma_wr16(s, pkthdr + PH_LEN, len + 4); /* +4: FCS the driver strips */
+    flags = dma_rd16(s, pkthdr + PH_FLAGS);
+    dma_wr16(s, pkthdr + PH_FLAGS, flags | 0x0003); /* CSUM_*_OK */
+    dma_wr8(s, pkthdr + PH_PORTLIST, HUB_EXT_PORTLIST);
+    vlan = dma_rd16(s, pkthdr + PH_VLAN);
+    dma_wr16(s, pkthdr + PH_VLAN, (vlan & 0xf000) | HUB_EXT_PORT_VID);
+    /* hand the descriptor to the CPU, consume the paired mbuf */
+    dma_wr32(s, guest_pa(base) + 4 * s->rx_cur[ring], entry & ~1u);
+    if (s->rmdcr) {
+        uint32_t mentry = dma_rd32(s, guest_pa(s->rmdcr) + 4 * s->mbuf_cur);
+        dma_wr32(s, guest_pa(s->rmdcr) + 4 * s->mbuf_cur, mentry & ~1u);
+        s->mbuf_cur++;
+        if (mentry & 2) {
+            s->mbuf_cur = 0;
+        }
+    }
+    s->rx_cur[ring] = (entry & 2) ? 0 : s->rx_cur[ring] + 1;
+    s->cpuiisr |= CPUIISR_RX_DONE(ring);
+    s->nic_rx_delivered++;
+    cpuif_update_irq(s);
+}
+
+static ssize_t cpuif_receive(NetClientState *nc, const uint8_t *buf,
+                             size_t size)
+{
+    RTL8196ESoc *s = qemu_get_nic_opaque(nc);
+
+    cpuif_deliver(s, buf, size);
+    return size;
+}
+
+static bool cpuif_can_receive(NetClientState *nc)
+{
+    return true; /* drops happen inside, with RUNOUT, as on silicon */
+}
+
+static void cpuif_tx_scan(RTL8196ESoc *s)
+{
+    uint8_t *frame = g_malloc(65536);
+    int r;
+
+    for (r = 0; r < 4; r++) {
+        uint32_t base = s->tpdcr[r];
+        bool sent = false;
+
+        if (base == 0) {
+            continue;
+        }
+        for (;;) {
+            uint32_t entry = dma_rd32(s, guest_pa(base) + 4 * s->tx_cur[r]);
+            uint32_t pkthdr, mbuf;
+            size_t total = 0;
+            int hops = 0;
+
+            if (!(entry & 1)) {
+                break;
+            }
+            pkthdr = guest_pa(entry & ~3u);
+            mbuf = guest_pa(dma_rd32(s, pkthdr + PH_MBUF));
+            while (mbuf && hops++ < 64 && total < 65000) {
+                uint16_t mlen = dma_rd16(s, mbuf + MB_LEN);
+                uint32_t mdata = guest_pa(dma_rd32(s, mbuf + MB_DATA));
+                uint8_t mflags;
+
+                if (mlen > 65000 - total) {
+                    mlen = 65000 - total;
+                }
+                address_space_read(&address_space_memory, mdata,
+                                   MEMTXATTRS_UNSPECIFIED,
+                                   frame + total, mlen);
+                total += mlen;
+                mflags = 0;
+                address_space_read(&address_space_memory, mbuf + MB_FLAGS,
+                                   MEMTXATTRS_UNSPECIFIED, &mflags, 1);
+                if (mflags & MBUF_EOR) {
+                    break;
+                }
+                mbuf = guest_pa(dma_rd32(s, mbuf + MB_NEXT));
+            }
+            if (s->nic && total >= 14) {
+                qemu_send_packet(&s->nic->ncs[0], frame, total);
+            }
+            s->nic_tx_sent++;
+            sent = true;
+            dma_wr32(s, guest_pa(base) + 4 * s->tx_cur[r], entry & ~1u);
+            s->tx_cur[r] = (entry & 2) ? 0 : s->tx_cur[r] + 1;
+            s->cpuiisr |= CPUIISR_TX_DONE(r);
+        }
+        if (sent) {
+            s->cpuiisr |= CPUIISR_TX_ALL_DONE(r);
+        }
+    }
+    g_free(frame);
+}
+
+static uint64_t cpuif_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RTL8196ESoc *s = opaque;
+    uint64_t r;
+
+    switch (offset) {
+    case 0x00:
+        return s->cpuicr;
+    case 0x04: case 0x08: case 0x0c: case 0x10: case 0x14: case 0x18:
+        return s->rpdcr[(offset - 0x04) / 4];
+    case 0x1c:
+        return s->rmdcr;
+    case 0x20:
+        return s->tpdcr[0];
+    case 0x24:
+        return s->tpdcr[1];
+    case 0x28:
+        return s->cpuiimr;
+    case 0x2c:
+        return s->cpuiisr;
+    case 0x30: case 0x34: case 0x38:
+        return s->cpuqdm[(offset - 0x30) / 4];
+    case 0x60:
+        r = s->tpdcr[2];
+        break;
+    case 0x64:
+        r = s->tpdcr[3];
+        break;
+    default:
+        r = 0;
+        break;
+    }
+    return r;
+}
+
+static void cpuif_write(void *opaque, hwaddr offset, uint64_t value,
+                        unsigned size)
+{
+    RTL8196ESoc *s = opaque;
+    uint32_t v = value;
+
+    switch (offset) {
+    case 0x00: /* CPUICR */
+        s->cpuicr = v;
+        if (v & CPUICR_SOFTRST) {
+            memset(s->rx_cur, 0, sizeof(s->rx_cur));
+            memset(s->tx_cur, 0, sizeof(s->tx_cur));
+            s->mbuf_cur = 0;
+            s->cpuicr &= ~CPUICR_SOFTRST;
+        }
+        if (v & CPUICR_TXFD) {
+            cpuif_tx_scan(s);
+            s->cpuicr &= ~CPUICR_TXFD;
+            cpuif_update_irq(s);
+        }
+        break;
+    case 0x04: case 0x08: case 0x0c: case 0x10: case 0x14: case 0x18:
+        s->rpdcr[(offset - 0x04) / 4] = v;
+        s->rx_cur[(offset - 0x04) / 4] = 0;
+        break;
+    case 0x1c:
+        s->rmdcr = v;
+        s->mbuf_cur = 0;
+        break;
+    case 0x20:
+        s->tpdcr[0] = v;
+        s->tx_cur[0] = 0;
+        break;
+    case 0x24:
+        s->tpdcr[1] = v;
+        s->tx_cur[1] = 0;
+        break;
+    case 0x28: /* CPUIIMR */
+        s->cpuiimr = v;
+        cpuif_update_irq(s);
+        break;
+    case 0x2c: /* CPUIISR: write-1-to-clear */
+        s->cpuiisr &= ~v;
+        cpuif_update_irq(s);
+        break;
+    case 0x30: case 0x34: case 0x38:
+        s->cpuqdm[(offset - 0x30) / 4] = v;
+        break;
+    case 0x60:
+        s->tpdcr[2] = v;
+        s->tx_cur[2] = 0;
+        break;
+    case 0x64:
+        s->tpdcr[3] = v;
+        s->tx_cur[3] = 0;
+        break;
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps cpuif_ops = {
+    .read = cpuif_read,
+    .write = cpuif_write,
+    .endianness = DEVICE_BIG_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static NetClientInfo cpuif_net_info = {
+    .type = NET_CLIENT_DRIVER_NIC,
+    .size = sizeof(NICState),
+    .can_receive = cpuif_can_receive,
+    .receive = cpuif_receive,
+};
+
+/* ---- timers ---- */
+
+static uint32_t tc_data(RTL8196ESoc *s, int i)
+{
+    return s->regs[(REG_TC0DATA + 4 * i) / 4];
+}
+
+static bool tc_en(RTL8196ESoc *s, int i)
+{
+    return (s->regs[REG_TCCNR / 4] >> (31 - 2 * i)) & 1;
+}
+
+static bool tc_mode_periodic(RTL8196ESoc *s, int i)
+{
+    return (s->regs[REG_TCCNR / 4] >> (30 - 2 * i)) & 1;
+}
+
+static bool tc_ie(RTL8196ESoc *s, int i)
+{
+    return (s->regs[REG_TCIR / 4] >> (31 - i)) & 1;
+}
+
+static uint64_t tc_tick_ns(RTL8196ESoc *s)
+{
+    uint32_t div = s->regs[REG_CDBR / 4] >> 16;
+
+    if (div == 0) {
+        div = 1;
+    }
+    return (uint64_t)div * 80; /* 12.5 MHz input clock: the guest
+     * programs CDBR/DATA for a 10 ms tick as 8929 ticks x div 14
+     * (~125000 counts), which is 12.5 MHz, not 200 MHz - at div*5
+     * guest time ran 16x fast and busybox login's 60 s alarm fired
+     * in ~3.8 wall seconds, breaking the 0.1 installer's telnet
+     * login cadence (measured on the bench 2026-11-11). */
+}
+
+static uint64_t tc_period_ticks(RTL8196ESoc *s, int i)
+{
+    return (uint64_t)(tc_data(s, i) >> 8) + 1;
+}
+
+static uint64_t tc_period_ns(RTL8196ESoc *s, int i)
+{
+    return tc_period_ticks(s, i) * tc_tick_ns(s);
+}
+
+static void tc_update_line(RTL8196ESoc *s, int i)
+{
+    bool ip = (s->regs[REG_TCIR / 4] >> (29 - i)) & 1;
+    int level = (ip && tc_ie(s, i)) ? 1 : 0;
+
+    s->src_level = deposit32(s->src_level, RTL_IRQ_TC0 + i, 1, level);
+    rtl_soc_update_irq(s);
+}
+
+static uint32_t tc_cnt_read(RTL8196ESoc *s, int i)
+{
+    uint64_t elapsed, ticks;
+
+    if (!tc_en(s, i)) {
+        return s->tc_frozen_cnt[i];
+    }
+    if (s->tc_expired[i]) {
+        return tc_data(s, i);
+    }
+    elapsed = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->tc_start_ns[i];
+    ticks = elapsed / tc_tick_ns(s);
+    if (ticks >= tc_period_ticks(s, i)) {
+        ticks = tc_period_ticks(s, i) - 1;
+    }
+    return (uint32_t)(ticks << 8);
+}
+
+typedef struct TCExpireCtx {
+    RTL8196ESoc *s;
+    int idx;
+} TCExpireCtx;
+
+static TCExpireCtx tc_ctx[2];
+
+static void tc_expire_cb(void *opaque)
+{
+    TCExpireCtx *ctx = opaque;
+    RTL8196ESoc *s = ctx->s;
+    int i = ctx->idx;
+    uint64_t period = tc_period_ns(s, i);
+
+    s->regs[REG_TCIR / 4] |= (i == 0 ? TC0IP : TC1IP);
+    if (tc_mode_periodic(s, i) && period > 0) {
+        s->tc_start_ns[i] += period;
+        if (s->tc_start_ns[i] + period <=
+            (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)) {
+            s->tc_start_ns[i] = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        }
+        timer_mod(s->tc_timer[i], s->tc_start_ns[i] + period);
+    } else {
+        s->tc_expired[i] = true;
+    }
+    tc_update_line(s, i);
+}
+
+static void tc_start(RTL8196ESoc *s, int i)
+{
+    uint64_t period = tc_period_ns(s, i);
+
+    s->tc_start_ns[i] = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    s->tc_expired[i] = false;
+    if (period > 0) {
+        timer_mod(s->tc_timer[i], s->tc_start_ns[i] + period);
+    }
+}
+
+static void tc_stop(RTL8196ESoc *s, int i)
+{
+    s->tc_frozen_cnt[i] = tc_cnt_read(s, i);
+    timer_del(s->tc_timer[i]);
+}
+
+/* ---- watchdog ---- */
+
+static void wdt_expire(void *opaque)
+{
+    RTL8196ESoc *s = opaque;
+
+    s->wdt_armed = false;
+    pending_reset_cause = RESET_CAUSE_WDT;
+    qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+}
+
+static void wdt_write(RTL8196ESoc *s, uint32_t value)
+{
+    if (value == 0) {
+        /* the kernel fault path: write 0 to force a watchdog reset */
+        timer_mod(s->wdt_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+        s->wdt_armed = true;
+    } else if (value & WDT_KICK_BIT) {
+        timer_mod(s->wdt_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + WDT_PERIOD_NS);
+        s->wdt_armed = true;
+    }
+}
+
+/* ---- SPI flash engine ----
+ *
+ * Byte-stream model of the controller in spi_common.c/spi_cmd.c:
+ * SFCSR bits 31:30 != 0b11 select the chip (01 = chip 0, the hub's
+ * only flash); the LEN field (bits 29:28) is bytes-1 per SFDR access;
+ * SFDR moves data MSB-first. RDY (bit 27) reads 1: transfers complete
+ * synchronously. JEDEC ID answers as the hub's actual chip, the
+ * GigaDevice GD25Q64 (C8 40 17), measured in Camille's hardware
+ * boot log 2026-11-11 -- the bootcode and the kernel SPI driver
+ * both name the chip from this answer, so the bench prints
+ * GD25Q64 like the silicon. (Was the Winbond W25Q64 entry,
+ * EF 40 17; same capacity byte, cosmetic delta only.)
+ */
+
+#define SFCSR_RDY       (1u << 27)
+#define SPI_JEDEC0      0xc8
+#define SPI_JEDEC1      0x40
+#define SPI_JEDEC2      0x17 /* SIZE2N_08MB */
+
+static void spi_sync_xip(RTL8196ESoc *s, uint32_t addr, uint32_t len)
+{
+    uint8_t *xip = memory_region_get_ram_ptr(&s->xip);
+
+    if (addr < RTL_FLASH_SIZE) {
+        if (addr + len > RTL_FLASH_SIZE) {
+            len = RTL_FLASH_SIZE - addr;
+        }
+        memcpy(xip + addr, s->flash + addr, len);
+    }
+}
+
+static void spi_erase(RTL8196ESoc *s, uint32_t addr, uint32_t len)
+{
+    if (addr >= RTL_FLASH_SIZE) {
+        return;
+    }
+    if (addr + len > RTL_FLASH_SIZE) {
+        len = RTL_FLASH_SIZE - addr;
+    }
+    memset(s->flash + addr, 0xff, len);
+    spi_sync_xip(s, addr, len);
+    s->spi_op_done = true;
+}
+
+/* clock one byte through the flash; returns the byte shifted in */
+static uint8_t spi_clock(RTL8196ESoc *s, uint8_t out)
+{
+    static const uint8_t jedec[3] = { SPI_JEDEC0, SPI_JEDEC1, SPI_JEDEC2 };
+
+    if (!s->spi_cs_active || !s->spi_chip_present) {
+        return 0xff;
+    }
+    if (s->spi_phase == 0) {
+        s->spi_cmd = out;
+        s->spi_count = 0;
+        s->spi_addr = 0;
+        switch (out) {
+        case 0x06: /* WREN */
+            if (!s->spi_powerdown) {
+                s->spi_wel = true;
+            }
+            s->spi_phase = 3;
+            break;
+        case 0x04: /* WRDI */
+            s->spi_wel = false;
+            s->spi_phase = 3;
+            break;
+        case 0xb9: /* DP */
+            s->spi_powerdown = true;
+            s->spi_phase = 3;
+            break;
+        case 0xab: /* RDP / RES */
+            s->spi_powerdown = false;
+            s->spi_phase = 3;
+            break;
+        case 0x60: /* CE */
+        case 0xc7:
+            if (s->spi_wel && !s->spi_powerdown) {
+                spi_erase(s, 0, RTL_FLASH_SIZE);
+            }
+            s->spi_phase = 3;
+            break;
+        case 0x03: /* READ */
+        case 0x02: /* PP */
+        case 0x20: /* SE */
+        case 0xd8: /* BE */
+            s->spi_phase = s->spi_powerdown ? 3 : 1;
+            break;
+        case 0x0b: /* FASTREAD: one dummy byte after the address */
+            s->spi_phase = s->spi_powerdown ? 3 : 1;
+            break;
+        default: /* RDID, RDSR, WRSR and anything else: data phase */
+            s->spi_phase = 3;
+            break;
+        }
+        return 0xff;
+    }
+    if (s->spi_phase == 1) { /* address, MSB first */
+        s->spi_addr = (s->spi_addr << 8) | out;
+        if (++s->spi_count == 3) {
+            s->spi_count = 0;
+            s->spi_page_base = s->spi_addr & ~0xffu;
+            if (s->spi_cmd == 0x0b) {
+                s->spi_phase = 2;
+            } else {
+                if (s->spi_wel && s->spi_cmd == 0x20) {
+                    spi_erase(s, s->spi_addr & ~0xfffu, 0x1000);
+                } else if (s->spi_wel && s->spi_cmd == 0xd8) {
+                    spi_erase(s, s->spi_addr & ~0xffffu, 0x10000);
+                }
+                s->spi_phase = 3;
+            }
+        }
+        return 0xff;
+    }
+    if (s->spi_phase == 2) { /* dummy */
+        s->spi_phase = 3;
+        return 0xff;
+    }
+    /* data phase */
+    s->spi_count++;
+    if (s->spi_powerdown) {
+        return 0xff;
+    }
+    switch (s->spi_cmd) {
+    case 0x9f: /* RDID */
+        return s->spi_count <= 3 ? jedec[s->spi_count - 1] : 0;
+    case 0x05: /* RDSR: WIP always 0, transfers are synchronous */
+        return s->spi_status | (s->spi_wel ? 0x02 : 0);
+    case 0x01: /* WRSR */
+        if (s->spi_count == 1) {
+            s->spi_status = out & 0xfc;
+        }
+        return 0xff;
+    case 0x03: /* READ */
+    case 0x0b: /* FASTREAD */
+        return s->flash[s->spi_addr++ & (RTL_FLASH_SIZE - 1)];
+    case 0x02: /* PP: programming only clears bits; wraps in page */
+        if (s->spi_wel) {
+            uint32_t a = s->spi_addr & (RTL_FLASH_SIZE - 1);
+
+            s->flash[a] &= out;
+            spi_sync_xip(s, a, 1);
+            s->spi_op_done = true;
+            s->spi_addr = s->spi_page_base |
+                          ((s->spi_addr + 1) & 0xff);
+        }
+        return 0xff;
+    default:
+        return 0xff;
+    }
+}
+
+static uint32_t spi_sfdr_read(RTL8196ESoc *s)
+{
+    int n = ((s->sfcsr >> 28) & 3) + 1;
+    uint32_t word = 0;
+    int i;
+
+    for (i = 0; i < n; i++) {
+        word |= (uint32_t)spi_clock(s, 0) << (24 - 8 * i);
+    }
+    return word;
+}
+
+static void spi_sfdr_write(RTL8196ESoc *s, uint32_t value)
+{
+    int n = ((s->sfcsr >> 28) & 3) + 1;
+    int i;
+
+    for (i = 0; i < n; i++) {
+        spi_clock(s, (value >> (24 - 8 * i)) & 0xff);
+    }
+}
+
+static void spi_sfcsr_write(RTL8196ESoc *s, uint32_t value)
+{
+    bool was = s->spi_cs_active;
+    bool now = ((value >> 30) & 3) != 3;
+
+    s->sfcsr = value;
+    s->spi_cs_active = now;
+    s->spi_chip_present = ((value >> 30) & 3) == 1;
+    if (now && !was) {
+        s->spi_phase = 0;
+        s->spi_count = 0;
+        s->spi_op_done = false;
+    } else if (!now && was && s->spi_op_done) {
+        s->spi_wel = false; /* WEL drops at the end of program/erase */
+        s->spi_op_done = false;
+        s->flash_dirty = true; /* a write the file must learn about */
+    }
+}
+
+/* ---- flash write-back ----
+ *
+ * The bench loads the flash image into RAM at realize and the SPI
+ * engine mutates that array. Real silicon persists those writes,
+ * and the flashing flow depends on the persistence (write a bank,
+ * power-cycle, the bootcode must see the new bank marks), so the
+ * array is written back to its backing file: on a 2 s cadence
+ * while dirty, and at every device reset (which covers the
+ * guest's reboot path). Added for the v35 virgin rehearsal
+ * 2026-11-11: before this, guest flash writes died with the QEMU
+ * process, and step 4's payload-verified flash silently
+ * evaporated on the power cycle. */
+static void flash_writeback(RTL8196ESoc *s)
+{
+    FILE *f;
+
+    if (!s->flash_dirty || !s->flash_file || !s->flash) {
+        return;
+    }
+    f = fopen(s->flash_file, "wb");
+    if (!f) {
+        fprintf(stderr, "FLASH-WRITEBACK FAILED: cannot open %s\n",
+                s->flash_file);
+        return;
+    }
+    if (fwrite(s->flash, 1, RTL_FLASH_SIZE, f) == RTL_FLASH_SIZE) {
+        s->flash_dirty = false;
+        fprintf(stderr, "FLASH-WRITEBACK %s (%d bytes)\n",
+                s->flash_file, RTL_FLASH_SIZE);
+    } else {
+        fprintf(stderr, "FLASH-WRITEBACK FAILED: short write on %s\n",
+                s->flash_file);
+    }
+    fclose(f);
+}
+
+static void flash_wb_timer_cb(void *opaque)
+{
+    RTL8196ESoc *s = opaque;
+
+    flash_writeback(s);
+    timer_mod(s->flash_wb_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + 2000000000LL);
+}
+
+/* ---- register file ---- */
+
+static uint32_t rtl_soc_reg_read(RTL8196ESoc *s, hwaddr offset)
+{
+    switch (offset) {
+    case REG_REVR:
+        return CHIP_ID_8196E;
+    case REG_RESETCAUSE:
+        return s->reset_cause;
+    case REG_STRAP:
+        return 0; /* low nibble must not be 0xd */
+    case REG_GIMR:
+        return s->gimr;
+    case REG_GISR:
+        return s->src_level;
+    case REG_IRR0:
+    case REG_IRR0 + 4:
+    case REG_IRR0 + 8:
+    case REG_IRR0 + 12:
+        return s->irr[(offset - REG_IRR0) / 4];
+    case REG_TC0CNT:
+        return tc_cnt_read(s, 0);
+    case REG_TC1CNT:
+        return tc_cnt_read(s, 1);
+    case REG_TCIR:
+        return s->regs[REG_TCIR / 4] & (TC0IE | TC1IE |
+                                        TC0IP | TC1IP);
+    case REG_SFCSR:
+        return s->sfcsr | SFCSR_RDY; /* transfers complete synchronously */
+    case REG_SFDR: {
+        uint32_t v = spi_sfdr_read(s);
+
+        if (s->spi_log) {
+            qemu_log("rtl8196e-spi: SFDR -> 0x%08x (cmd 0x%02x addr "
+                     "0x%06x phase %d)\n", v, s->spi_cmd, s->spi_addr,
+                     s->spi_phase);
+        }
+        return v;
+    }
+    default:
+{}        return s->regs[offset / 4];
+    }
+}
+
+static void rtl_soc_reg_write(RTL8196ESoc *s, hwaddr offset, uint32_t value)
+{
+    if (s->spi_log && offset >= 0x3000 && offset < 0x3120) {
+        qemu_log("rtl8196e-soc: write 0x%" HWADDR_PRIx " <- 0x%08x\n",
+                 offset, value);
+    }
+    switch (offset) {
+    case REG_REVR:
+    case REG_RESETCAUSE:
+    case REG_STRAP:
+    case REG_GISR:
+    case REG_TC0CNT:
+    case REG_TC1CNT:
+        break; /* read-only */
+    case REG_GIMR:
+        s->gimr = value;
+        rtl_soc_update_irq(s);
+        break;
+    case REG_IRR0:
+    case REG_IRR0 + 4:
+    case REG_IRR0 + 8:
+    case REG_IRR0 + 12:
+        s->irr[(offset - REG_IRR0) / 4] = value;
+        rtl_soc_update_irq(s);
+        break;
+    case REG_TCCNR: {
+        uint32_t old = s->regs[REG_TCCNR / 4];
+
+        s->regs[REG_TCCNR / 4] = value;
+        for (int i = 0; i < 2; i++) {
+            bool was = (old >> (31 - 2 * i)) & 1;
+            bool now = (value >> (31 - 2 * i)) & 1;
+
+            if (now && !was) {
+                tc_start(s, i);
+            } else if (!now && was) {
+                tc_stop(s, i);
+            }
+        }
+        break;
+    }
+    case REG_TCIR: {
+        uint32_t cur = s->regs[REG_TCIR / 4];
+
+        /* IE bits are plain storage; IP bits are write-1-to-clear */
+        cur &= ~(TC0IE | TC1IE);
+        cur |= value & (TC0IE | TC1IE);
+        if (value & TC0IP) {
+            cur &= ~TC0IP;
+        }
+        if (value & TC1IP) {
+            cur &= ~TC1IP;
+        }
+        s->regs[REG_TCIR / 4] = cur;
+        tc_update_line(s, 0);
+        tc_update_line(s, 1);
+        break;
+    }
+    case REG_WDTCNR:
+        s->regs[offset / 4] = value;
+        wdt_write(s, value);
+        break;
+    case REG_SFCSR:
+        spi_sfcsr_write(s, value);
+        break;
+    case REG_SFDR:
+        if (s->spi_log) {
+            qemu_log("rtl8196e-spi: SFDR <- 0x%08x\n", value);
+        }
+        spi_sfdr_write(s, value);
+        break;
+    case REG_SFCR:
+        s->regs[offset / 4] = value;
+        if (s->spi_log) {
+            qemu_log("rtl8196e-spi: SFCR <- 0x%08x\n", value);
+        }
+        break;
+    default:
+{}        s->regs[offset / 4] = value;
+        break;
+    }
+}
+
+static uint64_t rtl_soc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RTL8196ESoc *s = opaque;
+    uint32_t word = rtl_soc_reg_read(s, offset & ~3u);
+
+    return (word >> ((offset & 3) * 8)) & ((size == 4) ? 0xffffffffu :
+           ((1u << (size * 8)) - 1));
+}
+
+static void rtl_soc_write(void *opaque, hwaddr offset, uint64_t value,
+                          unsigned size)
+{
+    RTL8196ESoc *s = opaque;
+
+    if (size == 4 && (offset & 3) == 0) {
+        rtl_soc_reg_write(s, offset, (uint32_t)value);
+        return;
+    }
+    /* byte/halfword writes: read-modify-write the containing word */
+    uint32_t word = rtl_soc_reg_read(s, offset & ~3u);
+    int shift = (offset & 3) * 8;
+    uint32_t mask = (size == 4) ? 0xffffffffu :
+                    (((1u << (size * 8)) - 1) << shift);
+
+    word = (word & ~mask) | (((uint32_t)value << shift) & mask);
+    rtl_soc_reg_write(s, offset & ~3u, word);
+}
+
+static const MemoryRegionOps rtl_soc_ops = {
+    .read = rtl_soc_read,
+    .write = rtl_soc_write,
+    .endianness = DEVICE_BIG_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 4,
+};
+
+/* ---- SWCORE window ----
+ *
+ * Plain storage for the switch register file, except SWTCR0
+ * (SWCORE + 0x4418, rtl865xc_asicregs.h): bit 19 STOP_TLU_STA is a
+ * read-only status that reports the table-lookup engine stopped
+ * once software sets bit 18 STOP_TLU. The model executes the stop
+ * synchronously, so the status mirrors the command bit.
+ */
+
+#define SWCORE_SWTCR0   0x4418
+#define SWTCR0_STOP_TLU (1u << 18)
+#define SWTCR0_STOP_STA (1u << 19)
+
+static uint64_t rtl_swcore_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RTL8196ESoc *s = opaque;
+    uint32_t word;
+
+    memcpy(&word, s->swcore_mem + (offset & ~3u), 4);
+    word = be32_to_cpu(word);
+    if ((offset & ~3u) == SWCORE_SWTCR0) {
+        if (word & SWTCR0_STOP_TLU) {
+            word |= SWTCR0_STOP_STA;
+        } else {
+            word &= ~SWTCR0_STOP_STA;
+        }
+    }
+    return (word >> ((offset & 3) * 8)) &
+           ((size == 4) ? 0xffffffffu : ((1u << (size * 8)) - 1));
+}
+
+static uint32_t swcore_word(RTL8196ESoc *s, hwaddr offset)
+{
+    uint32_t word;
+
+    memcpy(&word, s->swcore_mem + offset, 4);
+    return be32_to_cpu(word);
+}
+
+static void swcore_store(RTL8196ESoc *s, hwaddr offset, uint32_t value)
+{
+    uint32_t word = cpu_to_be32(value);
+
+    memcpy(s->swcore_mem + offset, &word, 4);
+}
+
+/*
+ * TACI table-access engine (SWCORE + 0x4d00, rtl865xc_asicregs.h):
+ * SWTACR bit 0 is ACTION (1 = start, self-clears to DONE), bits
+ * 3:1 the command (ADD/MODIFY/FORCE write the entry held in
+ * TCR0..7 into the table SRAM at SWTAA; command 0 reads it back).
+ * SWTASR bit 0 reports TABSTS (0 = success). The model executes
+ * synchronously, as the ASIC does within a poll or two.
+ */
+#define SWCORE_SWTACR   0x4d00
+#define SWCORE_SWTASR   0x4d04
+#define SWCORE_SWTAA    0x4d08
+#define SWCORE_TCR0     0x4d20
+
+static void swtacr_write(RTL8196ESoc *s, uint32_t value)
+{
+    if (value & 1) {
+        uint32_t addr = swcore_word(s, SWCORE_SWTAA);
+        uint32_t off = addr & (RTL_SWTBL_SIZE - 1);
+        uint8_t *sram = memory_region_get_ram_ptr(&s->swtbl);
+        int i;
+
+        if (off + 32 <= RTL_SWTBL_SIZE) {
+            for (i = 0; i < 8; i++) {
+                uint32_t tcr = swcore_word(s, SWCORE_TCR0 + 4 * i);
+
+                if ((value >> 1) & 7) { /* write command: TCR -> SRAM */
+                    uint32_t be = cpu_to_be32(tcr);
+
+                    memcpy(sram + off + 4 * i, &be, 4);
+                } else { /* read command: SRAM -> TCR */
+                    uint32_t be;
+
+                    memcpy(&be, sram + off + 4 * i, 4);
+                    swcore_store(s, SWCORE_TCR0 + 4 * i, be32_to_cpu(be));
+                }
+            }
+        }
+        swcore_store(s, SWCORE_SWTASR, 0); /* TABSTS_SUCCESS */
+        value &= ~1u; /* ACTION_DONE */
+    }
+    swcore_store(s, SWCORE_SWTACR, value);
+}
+
+static void rtl_swcore_write(void *opaque, hwaddr offset, uint64_t value,
+                             unsigned size)
+{
+    RTL8196ESoc *s = opaque;
+    uint32_t word;
+    int shift = (offset & 3) * 8;
+    uint32_t mask = (size == 4) ? 0xffffffffu :
+                    (((1u << (size * 8)) - 1) << shift);
+
+    memcpy(&word, s->swcore_mem + (offset & ~3u), 4);
+    word = be32_to_cpu(word);
+    word = (word & ~mask) | (((uint32_t)value << shift) & mask);
+    if ((offset & ~3u) == SWCORE_SWTACR && size == 4) {
+        swtacr_write(s, word);
+        return;
+    }
+    word = cpu_to_be32(word);
+    memcpy(s->swcore_mem + (offset & ~3u), &word, 4);
+}
+
+static const MemoryRegionOps rtl_swcore_ops = {
+    .read = rtl_swcore_read,
+    .write = rtl_swcore_write,
+    .endianness = DEVICE_BIG_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 4,
+};
+
+/* ---- device lifecycle ---- */
+
+static void rtl_soc_reset_hold(Object *obj)
+{
+    RTL8196ESoc *s = RTL8196E_SOC(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    /* GPIO block reset state, measured on silicon at the monitor
+     * (DW B8003504, Camille 2026-11-11): 3504=0, 3508=FF000000,
+     * 350C=0000007C, 3510=0. The bootcode never writes 3508/350C/
+     * 3510, so monitor-time values are the reset values. 350C bit5
+     * matters: the bootcode's button check (0x80408B10) returns
+     * "pressed" when bit5 is CLEAR (its jr delay slot inverts) --
+     * with 350C left at 0, every long image checksum polled the
+     * check, read a phantom button press, and aborted validation
+     * for both banks, so a power-on boot always fell into the
+     * monitor. The pin idles high (pulled-up button input). */
+    flash_writeback(s); /* a reboot must boot what was written */
+    s->regs[0x3508 / 4] = 0xff000000;
+    s->regs[0x350c / 4] = 0x0000007c;
+    s->gimr = 0;
+    memset(s->irr, 0, sizeof(s->irr));
+    s->src_level = 0;
+    s->ip_sent = 0;
+    s->reset_cause = pending_reset_cause;
+    pending_reset_cause = 0;
+    s->tc_expired[0] = s->tc_expired[1] = false;
+    s->tc_frozen_cnt[0] = s->tc_frozen_cnt[1] = 0;
+    s->sfcsr = 0;
+    s->spi_cs_active = false;
+    s->spi_chip_present = false;
+    s->spi_op_done = false;
+    s->spi_phase = 0;
+    s->spi_count = 0;
+    s->spi_wel = false;
+    s->spi_status = 0;
+    s->spi_powerdown = false;
+    s->wdt_armed = false;
+    timer_del(s->tc_timer[0]);
+    timer_del(s->tc_timer[1]);
+    timer_del(s->wdt_timer);
+    rtl_soc_update_irq(s);
+}
+
+static void rtl_soc_realize(DeviceState *dev, Error **errp)
+{
+    RTL8196ESoc *s = RTL8196E_SOC(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+    g_autofree char *contents = NULL;
+    gsize len = 0;
+    int i;
+
+    if (!s->flash_file) {
+        error_setg(errp, "rtl8196e-soc: flash property is required");
+        return;
+    }
+    if (!g_file_get_contents(s->flash_file, &contents, &len, NULL)) {
+        error_setg(errp, "rtl8196e-soc: cannot read flash file %s",
+                   s->flash_file);
+        return;
+    }
+    if (len != RTL_FLASH_SIZE) {
+        error_setg(errp,
+                   "rtl8196e-soc: flash file %s is %zu bytes, expected %d",
+                   s->flash_file, len, RTL_FLASH_SIZE);
+        return;
+    }
+    s->flash = g_malloc(RTL_FLASH_SIZE);
+    memcpy(s->flash, contents, RTL_FLASH_SIZE);
+
+    memory_region_init_io(&s->mmio, OBJECT(dev), &rtl_soc_ops, s,
+                          "rtl8196e-soc.regs", RTL_SOC_SIZE);
+    sysbus_init_mmio(sbd, &s->mmio);
+
+    memory_region_init_ram(&s->xip, OBJECT(dev), "rtl8196e-soc.flash",
+                           RTL_FLASH_SIZE, &error_fatal);
+    memory_region_set_readonly(&s->xip, true);
+    /* the guest reads flash through this window; writes go through
+     * the SPI controller, which writes via this same host pointer */
+    memcpy(memory_region_get_ram_ptr(&s->xip), s->flash, RTL_FLASH_SIZE);
+    memory_region_add_subregion(get_system_memory(), RTL_XIP_BASE,
+                                &s->xip);
+    memory_region_init_alias(&s->xip_alias, OBJECT(dev),
+                             "rtl8196e-soc.flash-alias", &s->xip, 0,
+                             RTL_FLASH_SIZE);
+    memory_region_add_subregion(get_system_memory(), RTL_BOOT_ALIAS,
+                                &s->xip_alias);
+
+    memory_region_init_ram(&s->swtbl, OBJECT(dev), "rtl8196e-soc.swtbl",
+                           RTL_SWTBL_SIZE, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), RTL_SWTBL_BASE,
+                                &s->swtbl);
+    s->swcore_mem = g_malloc0(RTL_SWCORE_SIZE);
+    memory_region_init_io(&s->swcore, OBJECT(dev), &rtl_swcore_ops, s,
+                          "rtl8196e-soc.swcore", RTL_SWCORE_SIZE);
+    memory_region_add_subregion(get_system_memory(), RTL_SWCORE_BASE,
+                                &s->swcore);
+
+    memory_region_init_io(&s->cpuif, OBJECT(dev), &cpuif_ops, s,
+                          "rtl8196e-soc.cpuif", RTL_CPUIF_SIZE);
+    memory_region_add_subregion(get_system_memory(), RTL_CPUIF_BASE,
+                                &s->cpuif);
+    if (s->conf.peers.ncs[0]) {
+        s->nic = qemu_new_nic(&cpuif_net_info, &s->conf,
+                              TYPE_RTL8196E_SOC, "rtl8196e-nic",
+                              &dev->mem_reentrancy_guard, s);
+        qemu_set_info_str(&s->nic->ncs[0], "model=rtl8196e-cpuif");
+    }
+
+    /*
+     * PCIe root-complex window (0x18B00000): present but inert.
+     * The stock kernel's WLAN/PCIe probe configures the RC and
+     * scans for a card; the hub has none, and storage reads of 0
+     * make the probe bail exactly as an empty slot does.
+     */
+    memory_region_init_ram(&s->pcie, OBJECT(dev), "rtl8196e-soc.pcie",
+                           0x100000, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), 0x18b00000,
+                                &s->pcie);
+
+    qdev_init_gpio_in_named(dev, rtl_soc_set_src, "src", 32);
+    for (i = 0; i < 16; i++) {
+        sysbus_init_irq(sbd, &s->ip_out[i]);
+    }
+    for (i = 0; i < 2; i++) {
+        tc_ctx[i].s = s;
+        tc_ctx[i].idx = i;
+        s->tc_timer[i] = timer_new_ns(QEMU_CLOCK_VIRTUAL, tc_expire_cb,
+                                      &tc_ctx[i]);
+    }
+    s->wdt_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, wdt_expire, s);
+    s->flash_wb_timer = timer_new_ns(QEMU_CLOCK_REALTIME,
+                                     flash_wb_timer_cb, s);
+    timer_mod(s->flash_wb_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + 2000000000LL);
+}
+
+static Property rtl_soc_properties[] = {
+    DEFINE_PROP_STRING("flash", RTL8196ESoc, flash_file),
+    DEFINE_PROP_BOOL("spi-log", RTL8196ESoc, spi_log, false),
+    DEFINE_NIC_PROPERTIES(RTL8196ESoc, conf),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void rtl_soc_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = rtl_soc_realize;
+    dc->desc = "RTL8196E SoC register blocks (Sengled bench)";
+    rc->phases.hold = rtl_soc_reset_hold;
+    device_class_set_props(dc, rtl_soc_properties);
+}
+
+static const TypeInfo rtl_soc_type_info = {
+    .name = TYPE_RTL8196E_SOC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RTL8196ESoc),
+    .class_init = rtl_soc_class_init,
+};
+
+static void rtl_soc_register_types(void)
+{
+    type_register_static(&rtl_soc_type_info);
+}
+
+type_init(rtl_soc_register_types)
diff -ruN a/qemu-8.2.2/include/hw/char/rtl8196e_uart.h b/qemu-8.2.2/include/hw/char/rtl8196e_uart.h
--- a/qemu-8.2.2/include/hw/char/rtl8196e_uart.h	1969-12-31 19:00:00.000000000 -0500
+++ b/qemu-8.2.2/include/hw/char/rtl8196e_uart.h	2026-11-10 21:22:33.338250207 -0500
@@ -0,0 +1,25 @@
+/*
+ * RTL8196E UART: a 16550A (QEMU serial core) behind the SoC's lane
+ * wiring. The kernel drives it with byte accesses at base + 4 * reg;
+ * the bootcode uses 32-bit accesses with the register value in the top
+ * byte lane (it shifts received words right by 0x18). Stock serial-mm
+ * cannot express that (it masks word writes to the low byte), so this
+ * wrapper translates access sizes explicitly.
+ */
+#ifndef HW_CHAR_RTL8196E_UART_H
+#define HW_CHAR_RTL8196E_UART_H
+
+#include "hw/char/serial.h"
+#include "qom/object.h"
+
+#define TYPE_RTL8196E_UART "rtl8196e-uart"
+OBJECT_DECLARE_SIMPLE_TYPE(RTL8196EUart, RTL8196E_UART)
+
+struct RTL8196EUart {
+    SysBusDevice parent_obj;
+
+    SerialState serial;
+    MemoryRegion mmio;
+};
