diff -ruN a/qemu-8.2.2/hw/char/rtl8196e_uart.c b/qemu-8.2.2/hw/char/rtl8196e_uart.c
--- a/qemu-8.2.2/hw/char/rtl8196e_uart.c	1969-12-31 19:00:00.000000000 -0500
+++ b/qemu-8.2.2/hw/char/rtl8196e_uart.c	2026-11-10 22:56:21.515272998 -0500
@@ -0,0 +1,131 @@
+/*
+ * RTL8196E UART wrapper around the QEMU 16550A serial core.
+ * Lane contract established from the decompiled bootcode (stage 1
+ * writes divisor/LCR as 32-bit words with the value in bits 31:24)
+ * and the vendor kernel's 8250 probing (byte accesses, regshift 2).
+ */
+#include "qemu/osdep.h"
+#include "hw/char/rtl8196e_uart.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "qapi/error.h"
+
+#define RTL_UART_WINDOW 0x100
+#define RTL_UART_REGS   0x20 /* 8 registers, 4 bytes apart */
+
+static uint64_t rtl_uart_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RTL8196EUart *s = opaque;
+    uint64_t byte;
+    unsigned reg;
+
+    if (offset >= RTL_UART_REGS) {
+        return 0;
+    }
+    reg = (offset >> 2) & 7;
+    byte = serial_io_ops.read(&s->serial, reg, 1);
+    switch (size) {
+    case 1:
+        return (offset & 3) == 0 ? byte : 0;
+    case 2:
+        return (offset & 3) == 0 ? (byte << 8) : 0;
+    case 4:
+        return (offset & 3) == 0 ? (byte << 24) : 0;
+    default:
+        return 0;
+    }
+}
+
+static void rtl_uart_write(void *opaque, hwaddr offset, uint64_t value,
+                           unsigned size)
+{
+    RTL8196EUart *s = opaque;
+    unsigned reg;
+    uint8_t byte;
+
+    if (offset >= RTL_UART_REGS || (offset & 3) != 0) {
+        return;
+    }
+    reg = (offset >> 2) & 7;
+    switch (size) {
+    case 1:
+        byte = value & 0xff;
+        break;
+    case 2:
+        byte = (value >> 8) & 0xff;
+        break;
+    case 4:
+        byte = (value >> 24) & 0xff;
+        break;
+    default:
+        return;
+    }
+    serial_io_ops.write(&s->serial, reg, byte, 1);
+}
+
+static const MemoryRegionOps rtl_uart_ops = {
+    .read = rtl_uart_read,
+    .write = rtl_uart_write,
+    .endianness = DEVICE_BIG_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 4,
+};
+
+static void rtl_uart_realize(DeviceState *dev, Error **errp)
+{
+    RTL8196EUart *s = RTL8196E_UART(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    if (!qdev_realize(DEVICE(&s->serial), NULL, errp)) {
+        return;
+    }
+    /* the hub's UART clock is the 200 MHz system clock */
+    serial_set_frequency(&s->serial, 200000000);
+    sysbus_init_irq(sbd, &s->serial.irq);
+    memory_region_init_io(&s->mmio, OBJECT(dev), &rtl_uart_ops, s,
+                          "rtl8196e-uart", RTL_UART_WINDOW);
+    sysbus_init_mmio(sbd, &s->mmio);
+}
+
+static void rtl_uart_reset_hold(Object *obj)
+{
+    RTL8196EUart *s = RTL8196E_UART(obj);
+
+    device_cold_reset(DEVICE(&s->serial));
+}
+
+static void rtl_uart_init(Object *obj)
+{
+    RTL8196EUart *s = RTL8196E_UART(obj);
+
+    object_initialize_child(obj, "serial", &s->serial, TYPE_SERIAL);
+    object_property_add_alias(obj, "chardev", OBJECT(&s->serial),
+                              "chardev");
+}
+
+static void rtl_uart_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = rtl_uart_realize;
+    dc->desc = "RTL8196E UART (16550A, SoC lane wiring)";
+    rc->phases.hold = rtl_uart_reset_hold;
+}
+
+static const TypeInfo rtl_uart_type_info = {
+    .name = TYPE_RTL8196E_UART,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RTL8196EUart),
+    .instance_init = rtl_uart_init,
+    .class_init = rtl_uart_class_init,
+};
+
+static void rtl_uart_register_types(void)
+{
+    type_register_static(&rtl_uart_type_info);
+}
+
+type_init(rtl_uart_register_types)
