+++ b/qemu-8.2.2/include/hw/misc/rtl8196e_soc.h	2026-11-11 16:18:56.932022013 -0500
@@ -0,0 +1,127 @@
+/*
+ * RTL8196E SoC block for the Sengled Z02-HUB emulation bench.
+ *
+ * Models the register blocks the vendor boot path touches: system
+ * control, SPI flash controller window, interrupt controller, timers,
+ * watchdog and GPIO. Register contracts are taken from the vendor
+ * kernel source (arch/mips rtl8196c platform.h, arch/rlx BSP names) and
+ * the decompiled bootcode; see ../../emulation-design.md in the bench
+ * repository root for the full inventory and evidence.
+ */
+#ifndef HW_MISC_RTL8196E_SOC_H
+#define HW_MISC_RTL8196E_SOC_H
+
+#include "qom/object.h"
+#include "exec/memory.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+#include "net/net.h"
+
+#define TYPE_RTL8196E_SOC "rtl8196e-soc"
+OBJECT_DECLARE_SIMPLE_TYPE(RTL8196ESoc, RTL8196E_SOC)
+
+/* SoC register aperture (physical 0x18000000) */
+#define RTL_SOC_BASE        0x18000000
+#define RTL_SOC_SIZE        0x3600
+
+/* Flash XIP aperture: flash byte X is visible at RTL_XIP_BASE + X.
+ * The bootcode forms read addresses as 0xB8000000 + 0x05000000 + X
+ * (phys 0x1d000000 + X); its chain segment bases 0x05010000,
+ * 0x05020000, 0x05030000 are the +0x10000 segment steps on top of
+ * that constant, not part of the aperture base. */
+#define RTL_XIP_BASE        0x1d000000
+#define RTL_BOOT_ALIAS      0x1fc00000
+#define RTL_FLASH_SIZE      0x800000 /* 8 MiB */
+
+/* Switch table / core apertures (storage only until the NIC lands) */
+#define RTL_SWTBL_BASE      0x1b000000
+#define RTL_SWTBL_SIZE      0x140000
+#define RTL_SWCORE_BASE     0x1b800000
+#define RTL_SWCORE_SIZE     0x10000
+
+/* CPU packet interface registers (CPUICR, ring bases, CPUIIMR/ISR);
+ * storage until the Phase 3 DMA engine lands */
+#define RTL_CPUIF_BASE      0x18010000
+#define RTL_CPUIF_SIZE      0x1000
+
+/* Interrupt source line numbers (= GIMR/GISR bit positions, from
+ * boards/rtl8196e/bsp/bspchip.h: BSP_*_IE / BSP_*_IP) */
+#define RTL_IRQ_TC0         8
+#define RTL_IRQ_TC1         9
+#define RTL_IRQ_UART0       12
+#define RTL_IRQ_UART1       13
+#define RTL_IRQ_SWCORE      15
+
+struct RTL8196ESoc {
+    SysBusDevice parent_obj;
+
+    MemoryRegion mmio;
+    MemoryRegion xip;
+    MemoryRegion xip_alias;
+    MemoryRegion swtbl;
+    MemoryRegion swcore;
+    uint8_t *swcore_mem; /* backing for the SWCORE window (MMIO ops) */
+    MemoryRegion cpuif;
+    MemoryRegion pcie;
+
+    /* CPU packet interface (Phase 3 DMA engine) */
+    NICState *nic;
+    NICConf conf;
+    uint32_t cpuicr;   /* CPUICR: TXCMD/RXCMD/TXFD/SOFTRST + fields */
+    uint32_t cpuiimr;  /* CPUIIMR */
+    uint32_t cpuiisr;  /* CPUIISR (write-1-to-clear from the guest) */
+    uint32_t rpdcr[6]; /* CPURPDCR0-5: Rx pkthdr ring bases */
+    uint32_t rmdcr;    /* CPURMDCR0: Rx mbuf ring base */
+    uint32_t tpdcr[4]; /* CPUTPDCR0-3: Tx pkthdr ring bases */
+    uint32_t cpuqdm[3];/* CPUQDM0-5 storage (16-bit regs, packed) */
+    uint32_t rx_cur[6];  /* ASIC-side Rx cursor per ring */
+    uint32_t tx_cur[4];  /* ASIC-side Tx cursor per ring */
+    uint32_t mbuf_cur;   /* ASIC-side Rx mbuf ring cursor */
+    uint32_t nic_rx_delivered;
+    uint32_t nic_rx_runout;
+    uint32_t nic_tx_sent;
+
+    uint32_t regs[RTL_SOC_SIZE / 4];
+    uint32_t reset_cause;
+    uint32_t gimr;
+    uint32_t irr[4];
+    uint32_t src_level; /* GISR reflection: bit per source line */
+    uint32_t ip_sent;   /* last levels driven onto ip_out */
+
+    qemu_irq src_in[32]; /* gpio-in handlers write here via src_level */
+    qemu_irq ip_out[16]; /* sysbus IRQs: CPU IP0..IP7, then LOPI0..7 */
+
+    /* timers */
+    QEMUTimer *tc_timer[2];
+    uint64_t tc_start_ns[2];
+    uint32_t tc_frozen_cnt[2];
+    bool tc_expired[2];
+
+    /* watchdog */
+    QEMUTimer *wdt_timer;
+    bool wdt_armed;
+
+    /* flash backing */
+    uint8_t *flash;
+    char *flash_file;
+    bool spi_log;
+    bool flash_dirty;   /* guest program/erase landed; write-back due */
+    QEMUTimer *flash_wb_timer;
+
+    /* SPI flash engine state (SFCSR/SFDR byte stream) */
+    uint32_t sfcsr;
+    bool spi_cs_active;
+    bool spi_chip_present; /* CS pattern 01 = chip 0; chip 1 is absent */
+    bool spi_op_done;   /* a program/erase ran in this transaction */
+    uint8_t spi_cmd;
+    uint32_t spi_addr;
+    uint32_t spi_page_base;
+    int spi_phase;      /* 0 cmd, 1 addr, 2 dummy, 3 data */
+    int spi_count;      /* bytes consumed in the current phase */
+    bool spi_wel;
+    uint8_t spi_status; /* stored status bits (SRWD/BP), WEL/WIP apart */
+    bool spi_powerdown;
+};
+
+#endif
