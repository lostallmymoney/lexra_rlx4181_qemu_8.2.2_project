diff -ruN a/qemu-8.2.2/hw/mips/mips_int.c b/qemu-8.2.2/hw/mips/mips_int.c
--- a/qemu-8.2.2/hw/mips/mips_int.c	2024-03-04 12:48:15.000000000 -0500
+++ b/qemu-8.2.2/hw/mips/mips_int.c	2026-11-10 23:49:24.319248478 -0500
@@ -68,6 +68,52 @@
     g_free(qi);
 }
 
+/*
+ * Lexra LOPI input lines (RLX4181): line levels are reflected into
+ * ECause bits 16..23; delivery itself is decided in
+ * cpu_mips_hw_interrupts_pending() / mips_cpu_do_interrupt().
+ */
+static void cpu_mips_lx_irq_request(void *opaque, int irq, int level)
+{
+    MIPSCPU *cpu = opaque;
+    CPUMIPSState *env = &cpu->env;
+    CPUState *cs = CPU(cpu);
+    bool lopi_pending;
+
+    if (irq < 0 || irq > 7) {
+        return;
+    }
+
+    QEMU_IOTHREAD_LOCK_GUARD();
+
+    if (level) {
+        env->CP0_LXReg[1] |= 1u << (irq + 16);
+    } else {
+        env->CP0_LXReg[1] &= ~(1u << (irq + 16));
+    }
+
+    lopi_pending = env->CP0_LXReg[2] != 0 &&
+        (env->CP0_LXReg[1] & env->CP0_LXReg[0] & 0x00ff0000) != 0;
+    if ((env->CP0_Cause & CP0Ca_IP_mask) || lopi_pending) {
+        cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+    } else {
+        cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
+    }
+}
+
+void cpu_mips_lx_irq_init_cpu(MIPSCPU *cpu)
+{
+    CPUMIPSState *env = &cpu->env;
+    qemu_irq *qi;
+    int i;
+
+    qi = qemu_allocate_irqs(cpu_mips_lx_irq_request, cpu, 8);
+    for (i = 0; i < 8; i++) {
+        env->lx_irq[i] = qi[i];
+    }
+    g_free(qi);
+}
+
 void cpu_mips_soft_irq(CPUMIPSState *env, int irq, int level)
 {
     if (irq < 0 || irq > 2) {
diff -ruN a/qemu-8.2.2/hw/mips/rtl8196e.c b/qemu-8.2.2/hw/mips/rtl8196e.c
--- a/qemu-8.2.2/hw/mips/rtl8196e.c	1969-12-31 19:00:00.000000000 -0500
+++ b/qemu-8.2.2/hw/mips/rtl8196e.c	2026-11-11 04:27:51.709980457 -0500
@@ -0,0 +1,144 @@
+/*
+ * Machine for the Sengled Z02-HUB emulation bench: Realtek RTL8196E
+ * SoC, 32 MiB DRAM (proven from the bootcode's DCR write, see
+ * emulation-design.md), SPI flash backed by a stock dump image, two
+ * UARTs (console + EM357), and the SoC register blocks.
+ *
+ * Usage: -machine rtl8196e,flash=<fullflash-8mb.bin>
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/units.h"
+#include "exec/address-spaces.h"
+#include "exec/memory.h"
+#include "hw/boards.h"
+#include "hw/mips/mips.h"
+#include "hw/qdev-properties.h"
+#include "target/mips/cpu.h"
+#include "hw/misc/rtl8196e_soc.h"
+#include "hw/char/rtl8196e_uart.h"
+#include "hw/sysbus.h"
+#include "sysemu/sysemu.h"
+#include "net/net.h"
+
+#define TYPE_RTL8196E_MACHINE MACHINE_TYPE_NAME("rtl8196e")
+OBJECT_DECLARE_SIMPLE_TYPE(RTL8196EMachineState, RTL8196E_MACHINE)
+
+struct RTL8196EMachineState {
+    MachineState parent_obj;
+
+    char *flash_file;
+};
+
+#define RTL_RAM_SIZE (32 * MiB)
+#define RTL_UART0_BASE 0x18002000
+#define RTL_UART1_BASE 0x18002100
+/* IRQ source numbers come from hw/misc/rtl8196e_soc.h (the BSP
+ * GIMR-bit map: UART0 = 12, UART1 = 13). A local define here once
+ * wired UART0 to source 7 (the superseded design-section map),
+ * which silently cost the console its interrupts: kernel printk
+ * (polled) worked, interrupt-driven tty output never drained. */
+
+static void rtl8196e_init(MachineState *machine)
+{
+    RTL8196EMachineState *rms = RTL8196E_MACHINE(machine);
+    MIPSCPU *cpu;
+    CPUMIPSState *env;
+    DeviceState *soc;
+    SysBusDevice *soc_sbd;
+    MemoryRegion *ram = g_new0(MemoryRegion, 1);
+    int i;
+    cpu = MIPS_CPU(cpu_create(machine->cpu_type));
+    env = &cpu->env;
+    cpu_mips_irq_init_cpu(cpu);
+    cpu_mips_lx_irq_init_cpu(cpu);
+
+    memory_region_init_ram(ram, NULL, "rtl8196e.ram", RTL_RAM_SIZE,
+                           &error_fatal);
+
+    memory_region_add_subregion(get_system_memory(), 0, ram);
+
+    soc = qdev_new(TYPE_RTL8196E_SOC);
+    if (rms->flash_file) {
+        qdev_prop_set_string(soc, "flash", rms->flash_file);
+    }
+    if (nd_table[0].used) {
+        qdev_set_nic_properties(soc, &nd_table[0]);
+    }
+    soc_sbd = SYS_BUS_DEVICE(soc);
+    sysbus_realize_and_unref(soc_sbd, &error_fatal);
+    sysbus_mmio_map(soc_sbd, 0, RTL_SOC_BASE);
+    for (i = 0; i < 8; i++) {
+        sysbus_connect_irq(soc_sbd, i, env->irq[i]);
+    }
+    for (i = 0; i < 8; i++) {
+        sysbus_connect_irq(soc_sbd, 8 + i, env->lx_irq[i]);
+    }
+
+    for (i = 0; i < 2; i++) {
+        DeviceState *uart = qdev_new(TYPE_RTL8196E_UART);
+        SysBusDevice *uart_sbd = SYS_BUS_DEVICE(uart);
+        Chardev *chr = serial_hd(i);
+
+        if (chr) {
+            qdev_prop_set_chr(uart, "chardev", chr);
+        }
+        sysbus_realize_and_unref(uart_sbd, &error_fatal);
+        memory_region_add_subregion_overlap(
+            get_system_memory(),
+            i == 0 ? RTL_UART0_BASE : RTL_UART1_BASE,
+            sysbus_mmio_get_region(uart_sbd, 0), 1);
+        sysbus_connect_irq(uart_sbd, 0,
+                           qdev_get_gpio_in_named(soc, "src",
+                                                  i == 0 ? RTL_IRQ_UART0
+                                                         : RTL_IRQ_UART1));
+    }
+}
+
+static char *rtl8196e_flash_get(Object *obj, Error **errp)
+{
+    RTL8196EMachineState *rms = RTL8196E_MACHINE(obj);
+
+    return g_strdup(rms->flash_file);
+}
+
+static void rtl8196e_flash_set(Object *obj, const char *value,
+                               Error **errp)
+{
+    RTL8196EMachineState *rms = RTL8196E_MACHINE(obj);
+
+    g_free(rms->flash_file);
+    rms->flash_file = g_strdup(value);
+}
+
+static void rtl8196e_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "Sengled Z02-HUB (Realtek RTL8196E) emulation bench";
+    mc->init = rtl8196e_init;
+    mc->default_cpu_type = MIPS_CPU_TYPE_NAME("rlx4181");
+    mc->default_ram_size = RTL_RAM_SIZE;
+    mc->max_cpus = 1;
+    mc->minimum_page_bits = 12;
+
+    object_class_property_add_str(oc, "flash", rtl8196e_flash_get,
+                                  rtl8196e_flash_set);
+    object_class_property_set_description(oc, "flash",
+        "Path to the 8 MiB flash image (stock dump) backing the bench");
+}
+
+static const TypeInfo rtl8196e_machine_type_info = {
+    .name = TYPE_RTL8196E_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(RTL8196EMachineState),
+    .class_init = rtl8196e_class_init,
+    .class_size = sizeof(MachineClass),
+};
+
+static void rtl8196e_machine_register_types(void)
+{
+    type_register_static(&rtl8196e_machine_type_info);
+}
+
+type_init(rtl8196e_machine_register_types)
